# Copy to .env and fill in. .env is git-ignored — never commit real values.
# All secrets live here / in the deployment secret manager, never in code.

# PostgreSQL (target database, NOT the legacy SQL Server)
DATABASE_URL="postgresql://user:password@localhost:5432/hrms?schema=public"

# PII envelope encryption (D-015) — 32-byte base64 key(s); rotate via key id prefix
PII_ENC_KEY_ID="v1"
PII_ENC_KEY=""

# HMAC pepper for PII lookup hashes (D-015)
PII_HASH_PEPPER=""

# Auth (D-007)
JWT_SECRET=""
JWT_ACCESS_TTL="15m"
REFRESH_TTL_DAYS="14"

# Legacy DES key/IV — ONLY for the migration-window password verification (D-014).
# Rotate/remove after the migration window ends; never use for new secrets.
LEGACY_DES_KEY=""
LEGACY_DES_IV=""
